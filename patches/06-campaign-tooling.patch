+# Campaign template (PATCH 6). run_campaign.py fills save_root, project_name,
+# function_signatures, language, seed and repetition_index per run.
+oss_fuzz_dir: /home/ubuntu/fuzzing_workspace/oss-fuzz/
+save_root: outputs/campaign/
+cache_root: /home/ubuntu/fuzzing_workspace/cache/
+bench_dir: /home/ubuntu/fuzzing_workspace/LLM-reasoning-agents/benchmark-sets/function_0
+
+# LLM (temperature is not sent for gpt-5-mini; recorded in the manifest)
+model_name: "gpt-5-mini"
+base_url: ""
+temperature: 1
+reasoning: false
+model_token_limit: 8096
+usage_token_limit: 1000
+llm_max_retries: 2
+
+# Initial population (HarnessAgent-style generation)
+run_time: 1                 # minutes of validation fuzzing per generated harness
+max_fix: 5
+max_tool_call: 30
+fixing_mode: "agent"
