+language: "CPP"
diff --git a/scripts/campaign/check_campaign.py b/scripts/campaign/check_campaign.py
new file mode 100644
index 0000000..89a0082
--- /dev/null
+++ b/scripts/campaign/check_campaign.py
@@ -0,0 +1,67 @@
+"""Gates (run on the first finished runs before letting the campaign continue, and again at the end).
+
+G1/G2 hand-derived coverage reference passed, deterministic (scripts/p02_coverage_reference.sh output)
+G3 usage_log.jsonl lines == HTTP requests seen by httpx (per run audit file)
+G4 every generated harness saved and non-empty; lost initial attempts listed
+G5 no API key in any output
+G6 no run aborted (recursion limit or otherwise)
+G7 one clean code commit across runs; G8 one base-image id across runs
+Usage: python scripts/campaign/check_campaign.py [--out outputs/campaign] [--reference campaign/preflight_reference.txt]
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from utils.campaign import count_http_posts, files_with_secrets  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--out", default="outputs/campaign")
+ap.add_argument("--reference", default="campaign/preflight_reference.txt")
+args = ap.parse_args()
+out = Path(args.out)
+
+gates: list[tuple[str, bool, str]] = []
+ref = Path(args.reference).read_text() if Path(args.reference).exists() else ""
+gates.append(("G1 coverage == hand-derived reference", "PASS  A branches == 4/6" in ref and "OVERALL: PASS" in ref, args.reference))
+gates.append(("G2 three identical measurements", "PASS  A determinism" in ref, args.reference))
+
+manifests = sorted(out.glob("rep*/*/*/run_manifest.json"))
+commits, images, lost, aborted, g3_bad, g4_bad = set(), set(), [], [], [], []
+for mp in manifests:
+    m = json.loads(mp.read_text())
+    d = mp.parent
+    key = f"{m['project']}_rep{m['repetition_index']}"
+    commits.add((m["code"].get("commit"), m["code"].get("dirty")))
+    images.add(json.dumps({k: v.get("id") for k, v in m.get("docker_images_end", {}).items()}, sort_keys=True))
+    if m["status"] != "completed":
+        aborted.append(f"{key}:{m['status']}")
+    for a in m.get("initial_attempts", []):
+        if a["status"] != "OK":
+            lost.append(f"{key}#{a['index']}:{a['status']}:{(a.get('error') or '')[:60]}")
+    lines = sum(1 for _ in (d / "usage_log.jsonl").open()) if (d / "usage_log.jsonl").exists() else 0
+    posts = count_http_posts(out / "audit" / f"{key}.log")
+    if posts != lines:
+        g3_bad.append(f"{key}: usage={lines} http={posts}")
+    for g in d.glob("evolution/gen_*/*.json"):
+        gj = json.loads(g.read_text(encoding="utf-8"))
+        if not gj.get("code", "").strip():
+            g4_bad.append(str(g))
+
+gates.append(("G3 usage lines == HTTP requests", bool(manifests) and not g3_bad, "; ".join(g3_bad) or f"{len(manifests)} runs"))
+gates.append(("G4 harnesses saved and non-empty", not g4_bad, f"empty={len(g4_bad)} lost_initial_attempts={len(lost)}"))
+secrets = files_with_secrets(out)
+gates.append(("G5 no API key in outputs", not secrets, "; ".join(secrets[:5])))
+gates.append(("G6 no aborted run", not aborted, "; ".join(aborted)))
+gates.append(("G7 single clean code commit", len(commits) == 1 and not next(iter(commits))[1] if commits else False, str(commits)))
+gates.append(("G8 single base-image id", len(images) == 1, f"{len(images)} distinct"))
+
+for name, ok, detail in gates:
+    print(f"{'PASS' if ok else 'FAIL'}  {name}  [{detail}]")
+if lost:
+    print("lost initial attempts (recorded, not fatal):")
+    for x in lost:
+        print("  " + x)
+print(f"runs checked: {len(manifests)}")
+print("OVERALL:", "PASS" if all(ok for _, ok, _ in gates) else "FAIL")
diff --git a/scripts/campaign/eval_run.py b/scripts/campaign/eval_run.py
new file mode 100644
index 0000000..64fb434
--- /dev/null
+++ b/scripts/campaign/eval_run.py
@@ -0,0 +1,56 @@
+"""Step 4 (per run): llvm-cov branch coverage of the best generation-0 harness (non-evolutionary
+baseline) and the best final harness, each fuzzed for the same time with the same seed.
+
+Usage: python scripts/campaign/eval_run.py <target_dir> --cfg <run config.yaml> [--minutes 5]
+Writes <target_dir>/eval/eval_results.json
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from agent.eval import process_single_result  # noqa: E402
+from bench_cfg import BenchConfig  # noqa: E402
+from utils.campaign import pick_final_best, pick_gen0_best  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("target_dir")
+ap.add_argument("--cfg", required=True)
+ap.add_argument("--minutes", type=int, default=5)
+args = ap.parse_args()
+
+target_dir = Path(args.target_dir).resolve()
+manifest = json.loads((target_dir / "run_manifest.json").read_text())
+fuzzer_info = next(iter(sorted(target_dir.glob("run[0-9]*_*/fuzzer_info.json"))), None)
+if manifest.get("status") != "completed" or fuzzer_info is None:
+    sys.exit(f"cannot evaluate {target_dir}: status={manifest.get('status')} fuzzer_info={fuzzer_info}")
+
+results = {}
+first_by_genome = {}
+for label, genome in (("gen0_best", pick_gen0_best(target_dir)), ("final_best", pick_final_best(target_dir))):
+    if genome is None:
+        results[label] = {"genome_id": None, "coverage": {"status": "TOOL_FAILED", "error_message": "no genome"}}
+        continue
+    if genome["genome_id"] in first_by_genome:          # evolution kept the gen-0 harness: same code
+        results[label] = {**results[first_by_genome[genome["genome_id"]]], "reused_from": first_by_genome[genome["genome_id"]]}
+        continue
+    work = target_dir / "eval" / label / "work"
+    work.mkdir(parents=True, exist_ok=True)
+    (work / "harness.txt").write_text(genome["code"], encoding="utf-8")
+    (work / "function.txt").write_text(manifest["function"], encoding="utf-8")
+    (work / "fuzzer_info.json").write_text(fuzzer_info.read_text())
+    cfg = BenchConfig(args.cfg)
+    cfg.save_root = target_dir / "eval" / label
+    cfg.run_time = args.minutes
+    _, _, record = process_single_result((manifest["project"], manifest["function"], work, cfg))
+    results[label] = {"genome_id": genome["genome_id"], "generation": genome["generation"],
+                      "fitness_total": genome["fitness"]["total"], **record}
+    first_by_genome[genome["genome_id"]] = label
+
+out = target_dir / "eval" / "eval_results.json"
+out.parent.mkdir(parents=True, exist_ok=True)
+out.write_text(json.dumps({"fuzz_minutes": args.minutes, "results": results}, indent=2))
+for label, r in results.items():
+    c = r.get("coverage", {})
+    print(f"{label}: genome={r.get('genome_id')} status={c.get('status')} {c.get('metric')}={c.get('covered')}/{c.get('total')}")
diff --git a/scripts/campaign/run_campaign.py b/scripts/campaign/run_campaign.py
new file mode 100644
index 0000000..a1240ab
--- /dev/null
+++ b/scripts/campaign/run_campaign.py
@@ -0,0 +1,95 @@
+"""Step 3: run the campaign, one run at a time (4-core / 3 GB server).
+
+Order is target-major (all repetitions of a target before the next target), so if time runs
+out the campaign loses targets, never repetitions. Resumable: completed runs are skipped.
+Create <out>/STOP to stop cleanly after the current run.
+
+Usage: setsid nohup python scripts/campaign/run_campaign.py > outputs/campaign_launcher.log 2>&1 < /dev/null &
+Keep logs under outputs/ (git-ignored) so the code tree stays clean (gate G7).
+"""
+import argparse
+import json
+import os
+import shutil
+import subprocess as sp
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+import yaml
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from utils.campaign import LANG_LABEL, find_target_dir, manifest_status, rep_seed, run_key  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--targets", default="campaign/targets_selected.json")
+ap.add_argument("--template", default="cfg/campaign/campaign.yaml")
+ap.add_argument("--out", default="outputs/campaign")
+ap.add_argument("--reps", type=int, default=5)
+ap.add_argument("--campaign-seed", type=int, default=20261016)
+ap.add_argument("--eval-minutes", type=int, default=5)
+ap.add_argument("--dry-run", action="store_true")
+args = ap.parse_args()
+
+out = Path(args.out).resolve()
+for sub in ("configs", "logs", "audit", "timings"):
+    (out / sub).mkdir(parents=True, exist_ok=True)
+targets = json.loads(Path(args.targets).read_text())["selected"]
+template = yaml.safe_load(Path(args.template).read_text())
+progress = out / "progress.jsonl"
+
+
+def log_progress(**rec):
+    rec["timestamp"] = datetime.now(timezone.utc).isoformat()
+    with progress.open("a") as f:
+        f.write(json.dumps(rec) + "\n")
+
+
+for t in targets:
+    for r in range(1, args.reps + 1):
+        if (out / "STOP").exists():
+            print("STOP file found, exiting"); sys.exit(0)
+        key = run_key(t["project"], r)
+        save_root = out / f"rep{r}"
+        target_dir = find_target_dir(save_root, t["project"])
+        done = manifest_status(target_dir) == "completed" and (target_dir / "eval" / "eval_results.json").exists()
+        if done:
+            continue
+        if manifest_status(target_dir) not in (None, "completed"):
+            # never resume inside a failed run: its workspaces would be reused as CACHED harnesses
+            dest = out / "failed" / f"{key}_{int(time.time())}"
+            dest.parent.mkdir(parents=True, exist_ok=True)
+            shutil.move(str(target_dir.parent), str(dest))
+            for side in (out / "audit" / f"{key}.log", out / "timings" / f"{key}.jsonl"):
+                if side.exists():                          # keep G3 counts per attempt
+                    shutil.move(str(side), str(dest / side.name))
+            log_progress(run=key, phase="moved_failed_run", to=str(dest))
+            target_dir = None
+        cfg = {**template, "save_root": str(save_root), "project_name": [t["project"]],
+               "function_signatures": [t["signature"]], "language": LANG_LABEL[t["language"]],
+               "seed": rep_seed(args.campaign_seed, r), "repetition_index": r}
+        cfg_path = out / "configs" / f"{key}.yaml"
+        cfg_path.write_text(yaml.safe_dump(cfg, sort_keys=False))
+        env = {**os.environ, "LLMGA_HTTP_AUDIT": str(out / "audit" / f"{key}.log"),
+               "LLMGA_BUILD_TIMINGS": str(out / "timings" / f"{key}.jsonl")}
+        print(f"[{datetime.now():%m-%d %H:%M}] {key}: seed={cfg['seed']}", flush=True)
+        if args.dry_run:
+            continue
+        t0 = time.time()
+        if manifest_status(target_dir) != "completed":
+            with (out / "logs" / f"{key}.log").open("a") as lf:
+                rc = sp.run([sys.executable, "-m", "agent.run_evo_gen", str(cfg_path), "--processes", "1",
+                             "--project", t["project"], "--function", t["signature"]],
+                            stdout=lf, stderr=sp.STDOUT, stdin=sp.DEVNULL, env=env).returncode
+            target_dir = find_target_dir(save_root, t["project"])
+            log_progress(run=key, phase="evolution", rc=rc, status=manifest_status(target_dir),
+                         seconds=round(time.time() - t0))
+        if manifest_status(target_dir) == "completed":
+            t1 = time.time()
+            with (out / "logs" / f"{key}.eval.log").open("a") as lf:
+                rc = sp.run([sys.executable, "scripts/campaign/eval_run.py", str(target_dir), "--cfg", str(cfg_path),
+                             "--minutes", str(args.eval_minutes)], stdout=lf, stderr=sp.STDOUT,
+                            stdin=sp.DEVNULL, env=env).returncode
+            log_progress(run=key, phase="eval", rc=rc, seconds=round(time.time() - t1))
+print("campaign finished")
