+"""Step 1: seeded, language-stratified order of all benchmark targets + quotas for N targets.
+
+Commit the output before any run. Screening (screen_targets.py) walks this order.
+Usage: python scripts/campaign/sample_targets.py --n 12 --seed 20261016 --out campaign/targets_ordered.json
+"""
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from utils.campaign import load_benchmark, stratified_order  # noqa: E402
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--bench-dir", default="benchmark-sets/function_0")
+ap.add_argument("--n", type=int, default=12)
+ap.add_argument("--seed", type=int, default=20261016)
+ap.add_argument("--out", default="campaign/targets_ordered.json")
+args = ap.parse_args()
+
+targets = load_benchmark(Path(args.bench_dir))
+plan = stratified_order(targets, args.seed, args.n)
+plan["bench_dir"] = args.bench_dir
+out = Path(args.out)
+out.parent.mkdir(parents=True, exist_ok=True)
+out.write_text(json.dumps(plan, indent=2))
+print(f"targets: {len(targets)}  counts: {plan['counts']}  quota: {plan['quota']}  seed: {args.seed}")
+for lang, items in plan["order"].items():
+    print(f"  {lang}: first 6 in order -> {[t['project'] for t in items[:6]]}")
+print(f"written: {out}")
diff --git a/scripts/campaign/screen_targets.py b/scripts/campaign/screen_targets.py
new file mode 100644
index 0000000..aee57ef
--- /dev/null
+++ b/scripts/campaign/screen_targets.py
@@ -0,0 +1,78 @@
+"""Step 2: walk the seeded order and keep the first targets whose OSS-Fuzz build succeeds within
+the time cap (this 4-core / 3 GB server allows ~2 h per run). Every rejection is recorded.
+
+Builds the original OSS-Fuzz project (address sanitizer, no harness change), pulls nothing,
+and removes the project image afterwards to save disk.
+Usage: python scripts/campaign/screen_targets.py --cap 120 [--ordered campaign/targets_ordered.json]
+"""
+import argparse
+import json
+import subprocess as sp
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--ordered", default="campaign/targets_ordered.json")
+ap.add_argument("--oss-fuzz", default="/home/ubuntu/fuzzing_workspace/oss-fuzz")
+ap.add_argument("--cap", type=int, default=120, help="max seconds for build_fuzzers")
+ap.add_argument("--out", default="campaign/targets_selected.json")
+ap.add_argument("--log", default="campaign/screening.jsonl")
+args = ap.parse_args()
+
+plan = json.loads(Path(args.ordered).read_text())
+helper = Path(args.oss_fuzz) / "infra" / "helper.py"
+log = Path(args.log)
+done = {json.loads(x)["project"]: json.loads(x) for x in log.read_text().splitlines()} if log.exists() else {}
+
+
+def run(cmd, timeout):
+    t0 = time.monotonic()
+    try:
+        p = sp.run(cmd, stdin=sp.DEVNULL, stdout=sp.PIPE, stderr=sp.STDOUT, text=True, timeout=timeout)
+        return p.returncode, time.monotonic() - t0, p.stdout[-2000:]
+    except sp.TimeoutExpired:
+        return "timeout", time.monotonic() - t0, ""
+
+
+selected = []
+for lang, quota in plan["quota"].items():
+    accepted = 0
+    for t in plan["order"][lang]:
+        if accepted >= quota:
+            break
+        rec = done.get(t["project"])
+        if rec is None:
+            proj = t["project"]
+            rc_i, img_s, _ = run(["python3", str(helper), "build_image", proj, "--no-pull"], 1800)
+            rc_b, fz_s, tail = (None, None, "")
+            if rc_i == 0:
+                rc_b, fz_s, tail = run(["python3", str(helper), "build_fuzzers", proj], args.cap + 60)
+            fuzzer = Path(args.oss_fuzz) / "build" / "out" / proj / (t["target_name"] or "")
+            if rc_i != 0:
+                result = "image_failed"
+            elif rc_b == "timeout" or (fz_s or 0) > args.cap:
+                result = "too_slow"
+            elif rc_b != 0:
+                result = "build_failed"
+            elif not (t["target_name"] and fuzzer.exists()):
+                result = "fuzzer_missing"
+            else:
+                result = "ok"
+            rec = {"timestamp": datetime.now(timezone.utc).isoformat(), "project": proj, "language": lang,
+                   "build_image_s": round(img_s, 1), "build_fuzzers_s": None if fz_s is None else round(fz_s, 1),
+                   "cap_s": args.cap, "result": result, "tail": tail[-500:] if result != "ok" else ""}
+            with log.open("a") as f:
+                f.write(json.dumps(rec) + "\n")
+            sp.run(["docker", "rmi", "-f", f"gcr.io/oss-fuzz/{proj}"], stdout=sp.DEVNULL, stderr=sp.DEVNULL)
+        print(f"{lang:4s} {t['project']:28s} {rec['result']:15s} build_fuzzers={rec['build_fuzzers_s']}s")
+        if rec["result"] == "ok":
+            accepted += 1
+            selected.append({**t, "screen": rec})
+    if accepted < quota:
+        print(f"WARNING: only {accepted}/{quota} {lang} targets passed the screen")
+
+Path(args.out).write_text(json.dumps({"cap_s": args.cap, "seed": plan["seed"], "quota": plan["quota"],
+                                      "selected": selected}, indent=2))
+print(f"selected {len(selected)} targets -> {args.out}")
diff --git a/tests/test_p06_campaign.py b/tests/test_p06_campaign.py
new file mode 100644
index 0000000..5794627
--- /dev/null
+++ b/tests/test_p06_campaign.py
@@ -0,0 +1,55 @@
+"""PATCH 6: campaign sampling and bookkeeping."""
+import json
+from pathlib import Path
+
+from utils.campaign import (count_http_posts, files_with_secrets, load_benchmark, pick_final_best,
+                            pick_gen0_best, rep_seed, stratified_order)
+
+BENCH = Path(__file__).resolve().parent.parent / "benchmark-sets" / "function_0"
+
+
+def test_benchmark_has_243_targets_66_c_177_cpp():
+    targets = load_benchmark(BENCH)
+    assert len(targets) == 243
+    langs = [t["language"] for t in targets]
+    assert (langs.count("c"), langs.count("c++")) == (66, 177)
+
+
+def test_stratified_order_is_seeded_and_proportional():
+    targets = load_benchmark(BENCH)
+    a, b, c = (stratified_order(targets, s, 12) for s in (20261016, 20261016, 7))
+    assert a["quota"] == {"c": 3, "c++": 9}
+    assert a["order"] == b["order"] and a["order"] != c["order"]
+    assert sorted(t["project"] for t in a["order"]["c"]) == sorted(t["project"] for t in targets if t["language"] == "c")
+
+
+def test_rep_seeds_differ():
+    assert len({rep_seed(20261016, r) for r in range(1, 6)}) == 5
+
+
+def _genome(path, gid, gen, total, code="int x;", ok=True):
+    path.write_text(json.dumps({"genome_id": gid, "generation": gen, "code": code, "compile_ok": ok,
+                                "fitness": {"total": total}}))
+
+
+def test_pick_gen0_and_final_best(tmp_path):
+    g0 = tmp_path / "evolution" / "gen_000"
+    g0.mkdir(parents=True)
+    _genome(g0 / "00_a.json", "a", 0, 0.7)
+    _genome(g0 / "01_b.json", "b", 0, 0.9)
+    _genome(g0 / "02_c.json", "c", 0, 1.5, ok=False)        # not compiled: never the baseline
+    fin = tmp_path / "evolution" / "final"
+    fin.mkdir(parents=True)
+    _genome(fin / "best_01_d.json", "d", 3, 0.95)
+    assert pick_gen0_best(tmp_path)["genome_id"] == "b"
+    assert pick_final_best(tmp_path)["genome_id"] == "d"
+
+
+def test_http_posts_and_secret_scan(tmp_path):
+    audit = tmp_path / "a.log"
+    audit.write_text('x HTTP Request: POST https://api.openai.com/v1/chat/completions "HTTP/1.1 200 OK"\nother\n' * 3)
+    assert count_http_posts(audit) == 3 and count_http_posts(tmp_path / "missing.log") is None
+    (tmp_path / "clean.txt").write_text("sk-ssh-ed25519-cert-v01@openssh.com")      # OpenSSH key type, not a secret
+    assert files_with_secrets(tmp_path) == []
+    (tmp_path / "leak.txt").write_text("key=" + "sk-" + "proj-" + "A" * 40)
+    assert files_with_secrets(tmp_path) == [str(tmp_path / "leak.txt")]
